# ---------------------------------------------------------------------------
# ChargeSquare case study — example environment.
# Copy to `.env` (`cp .env.example .env`) before running docker compose.
# These are LOCAL DEV placeholders only. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Database (shared by both services) ---
POSTGRES_DB=chargesquare
POSTGRES_USER=chargesquare
POSTGRES_PASSWORD=change-me-locally
# JDBC URL the services use to reach Postgres (host is the compose service name).
DB_URL=jdbc:postgresql://postgres:5432/chargesquare

# --- Service wiring ---
# Base URL Session Service uses to reach Station Service (real network call).
STATION_SERVICE_URL=http://station-service:8081

# --- Security (Stage 2) ---
# Turn JWT/RBAC on (true) or run an open Stage-1-only backend (false).
SECURITY_ENABLED=true
# HS256 signing key shared by both services. Must be >= 32 bytes. Rotate for real deploys.
JWT_SECRET=local-dev-signing-key-please-change-me-32b
# Token lifetime in minutes.
JWT_EXPIRY_MINUTES=120

# --- Seeded demo panel users (Stage 2). Local dev only. ---
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer123

# --- Web panel ---
# Base URLs the SPA calls (used at build time by Vite).
VITE_SESSION_API=http://localhost:8082
VITE_STATION_API=http://localhost:8081
